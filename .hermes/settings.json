{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning --experimental-strip-types \"${HERMES_PROJECT_DIR:-.}/.claude/scripts/session-start.ts\"",
            "timeout": 30000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning --experimental-strip-types \"${HERMES_PROJECT_DIR:-.}/.claude/scripts/classify-message.ts\"",
            "timeout": 15000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning --experimental-strip-types \"${HERMES_PROJECT_DIR:-.}/.claude/scripts/validate-write.ts\"",
            "timeout": 15000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning --experimental-strip-types \"${HERMES_PROJECT_DIR:-.}/.claude/scripts/pre-compact.ts\"",
            "timeout": 30000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning --experimental-strip-types \"${HERMES_PROJECT_DIR:-.}/.claude/scripts/stop-checklist.ts\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
